# --- Local defaults (no paid keys required) ---
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# PODCAST_HOST_NAME=Alex

# Default edge-tts: expressive Aria neural, slight slow + pitch lift
# EDGE_TTS_VOICE=en-US-AriaNeural
# EDGE_TTS_RATE=-8%
# EDGE_TTS_PITCH=+2Hz

# Optional overrides for musical cue assets
# PODCAST_STING_INTRO=/absolute/path/to/podcast_sting_intro.mp3
# PODCAST_STING_MID=/absolute/path/to/podcast_sting_mid.mp3
# PODCAST_STING_OUTRO=/absolute/path/to/podcast_sting_outro.mp3

# --- Optional paid upgrades (blank = stay on local defaults) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=

# Optional paid overrides
# OPENAI_MODEL=gpt-4o-mini
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
